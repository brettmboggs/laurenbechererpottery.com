---
/**
 * A single piece.
 *
 * Layout holds everything a piece will eventually have — dimensions,
 * materials, firing, care, price, more photographs, and scene photography of
 * the piece in use. None of it is invented. A fact that has not been recorded
 * says so; a section with nothing in it does not render.
 */
import Base from '../../layouts/Base.astro';
import PieceViewer from '../../components/PieceViewer.astro';
import PieceCard from '../../components/PieceCard.astro';
import EditLink from '../../components/EditLink.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getSpinRecord, framePath, widthUpTo, paletteVars } from '../../lib/spins';
import { sortPieces } from '../../lib/pieces';

export async function getStaticPaths() {
  const pieces = await getCollection('pieces');
  return pieces.map((p) => ({ params: { slug: p.id }, props: { piece: p } }));
}

const { piece } = Astro.props;
const d = piece.data;
const { Content } = await render(piece);
const settings = (await getEntry('settings', 'site'))!.data;
const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const spin = getSpinRecord(d.spin);
const hero = d.cover || (spin ? framePath(spin, widthUpTo(spin, 1200), 0) : undefined);

const more = sortPieces(
  await getCollection('pieces', (p) => p.id !== piece.id && p.data.showInPortfolio)
).slice(0, 3);

const canBuy = d.forSale && d.status === 'available';
const inquire = `mailto:${settings.email ?? ''}?subject=${encodeURIComponent(`Inquiry: ${d.title}`)}`;
const statusLabel: Record<string, string> = {
  available: 'Available',
  sold: 'Sold',
  reserved: 'Reserved',
  commission: 'Commission piece',
};

const care =
  d.care ||
  settings.careNote ||
  'Hand wash. Details on food safety and care are being written up for each glaze.';

const sceneLabel: Record<string, string> = {
  styled: 'Styled',
  'in-use': 'In use',
  detail: 'Detail',
  scale: 'For scale',
};

// Structured data. Only what is actually known goes in: no price is better
// than a made-up one, and Google is happier with an omitted field than a wrong one.
const availability: Record<string, string> = { available: 'InStock', reserved: 'PreOrder', sold: 'SoldOut', commission: 'PreOrder' };
const images = [hero, ...d.gallery.map((g) => g.image), ...d.scenes.map((s) => s.image)].filter(Boolean) as string[];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  description: d.materials ? `${d.title}. ${d.materials}.` : d.title,
  image: images.map((p) => new URL(p, Astro.site).href),
  brand: { '@type': 'Brand', name: settings.title },
  ...(d.materials ? { material: d.materials } : {}),
  ...(d.forSale && d.price != null
    ? {
        offers: {
          '@type': 'Offer',
          price: d.price,
          priceCurrency: 'USD',
          availability: `https://schema.org/${availability[d.status]}`,
          url: new URL(Astro.url.pathname, Astro.site).href,
        },
      }
    : {}),
};
---
<Base
  title={d.title}
  description={`${d.title} — ${d.materials ?? 'handmade ceramics'} by Lauren Becherer.`}
  image={hero}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="section" style={paletteVars(spin)}>
    <div class="wrap">
      <a class="back" href="/portfolio/">← All work</a>

      <div class="piece">
        <div class="viewer-col">
          <PieceViewer
            title={d.title}
            cover={d.cover || undefined}
            gallery={d.gallery}
            spin={spin}
            model={d.model || undefined}
            modelAutoRotate={d.modelAutoRotate}
          />
        </div>

        <div class="info">
          {d.collection && <p class="eyebrow">{d.collection}</p>}
          <h1>{d.title}</h1>
          {d.workingTitle && (
            /* Honest about the gap rather than shipping an invented product name. */
            <p class="working">Working title — not yet named</p>
          )}

          <p class="status" data-status={d.status}>
            {statusLabel[d.status]}
            {d.forSale && d.price != null && <span> · {money(d.price)}</span>}
            {d.forSale && d.price == null && <span class="pending"> · price to come</span>}
          </p>

          <div class="buy">
            {canBuy && d.stripeLink && (
              <a class="btn" href={d.stripeLink} target="_blank" rel="noopener">Buy — {money(d.price ?? 0)}</a>
            )}
            {canBuy && !d.stripeLink && <a class="btn" href={inquire}>Inquire to purchase</a>}
            {!canBuy && d.status !== 'sold' && <a class="btn ghost" href={inquire}>Ask about this piece</a>}
            {d.status === 'sold' && <a class="btn ghost" href="/client/">Commission something similar</a>}
          </div>

          <dl class="specs">
            <dt>Dimensions</dt>
            <dd>{d.dimensions ?? <span class="pending">Not yet measured</span>}</dd>

            <dt>Materials</dt>
            <dd>{d.materials ?? <span class="pending">To be recorded</span>}</dd>

            {d.firing && <><dt>Firing</dt><dd>{d.firing}</dd></>}

            <dt>Made</dt>
            <dd>{d.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' })}</dd>
          </dl>

          {piece.body?.trim() && <div class="prose"><Content /></div>}

          <p class="care">{care}</p>
        </div>
      </div>

      {d.scenes.length > 0 && (
        /* Scene photography: the piece filled, used, lived with. Renders only
           once there is something to show. */
        <section class="scenes">
          <div class="section-head"><h2>In use</h2></div>
          <div class="scene-grid">
            {d.scenes.map((s) => (
              <figure class="scene" data-kind={s.kind}>
                <img src={s.image} alt={s.alt ?? `${d.title}, ${sceneLabel[s.kind].toLowerCase()}`} loading="lazy" />
                {(s.caption || s.kind !== 'styled') && (
                  <figcaption>
                    <span class="kind">{sceneLabel[s.kind]}</span>
                    {s.caption && <span>{s.caption}</span>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )}

      {more.length > 0 && (
        <section class="more">
          <div class="section-head">
            <h2>More work</h2>
            <a class="btn quiet small" href="/portfolio/">All work →</a>
          </div>
          <div class="grid cols-3">
            {more.map((p) => <PieceCard piece={p} showPrice={p.data.forSale} />)}
          </div>
        </section>
      )}
    </div>
  </article>

  <EditLink collection="pieces" entry={piece.id} label="edit this piece" />
</Base>

<style>
  .back {
    display: inline-block; margin-bottom: 2rem;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: lowercase;
    color: var(--fg-faint);
  }
  .back:hover { color: var(--ink); }

  .piece {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .viewer-col { position: sticky; top: 100px; }

  .info h1 { margin-bottom: 0.25rem; }
  .working {
    margin: 0 0 1rem;
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: lowercase;
    color: var(--fg-faint);
  }
  .status { font-size: 0.82rem; letter-spacing: 0.06em; text-transform: lowercase; color: var(--fg-soft); margin-bottom: 1.75rem; }
  .status[data-status="sold"] { color: var(--fg-faint); }

  .buy { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem; }

  .specs {
    display: grid; grid-template-columns: 9rem 1fr;
    gap: 0 1.5rem; margin: 0 0 2.5rem;
    border-top: 1px solid var(--line);
  }
  .specs dt {
    padding: 0.85rem 0 0;
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: lowercase;
    color: var(--fg-faint);
  }
  .specs dd {
    margin: 0; padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-soft);
  }
  .specs dt + dd { grid-column: 2; }

  .care { font-size: 0.85rem; color: var(--fg-faint); border-top: 1px solid var(--line); padding-top: 1.25rem; }

  .scenes, .more { margin-top: clamp(4rem, 9vw, 7rem); }
  .scene-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }
  .scene { margin: 0; }
  .scene img { width: 100%; border-radius: var(--radius); border: 1px solid var(--line); }
  /* A styled shot of the whole setting earns more room than a detail crop. */
  .scene[data-kind="styled"] { grid-column: span 2; }
  .scene figcaption {
    margin-top: 0.6rem; display: flex; gap: 0.6rem; flex-wrap: wrap;
    font-size: 0.78rem; color: var(--fg-faint);
  }
  .scene .kind { letter-spacing: 0.12em; text-transform: lowercase; font-size: 0.66rem; font-weight: 600; }

  @media (max-width: 900px) {
    .piece { grid-template-columns: 1fr; }
    .viewer-col { position: static; }
    .scene[data-kind="styled"] { grid-column: auto; }
  }
</style>
