---
/**
 * The full-size turntable on a piece's own page.
 *
 * One thing, one control. Drag it to turn it, or press the button and let it
 * turn itself. There is no background switch and no treatment picker: the
 * piece is shown the way it was photographed.
 *
 * Where the rotation angles were measured off the real shoot, playback maps
 * through them so the piece turns at a constant rate even though the
 * photographed steps are uneven. The turn is a little steppy because every
 * frame is a real photograph and nothing between them is invented.
 *
 * Arriving from a tile, the piece grows out of that tile (a view transition
 * named in `transitionName`) and carries on from the angle it was showing. On
 * a phone it can also follow the phone's tilt, as if turned in the hands.
 */
import { getEntry } from 'astro:content';
import type { SpinRecord } from '../lib/spins';
import { spinSpec, framePath, frameSrcSet, widthUpTo, paletteVars } from '../lib/spins';

interface Props {
  record: SpinRecord;
  title: string;
  /** Shared with the tile that links here, so one morphs into the other. */
  transitionName?: string;
}

const { record, title, transitionName } = Astro.props;
const t = (await getEntry('piece', 'piece'))!.data;
// One piece, one viewer: it can afford the largest size the screen justifies.
const spec = spinSpec(record, 1200);
const size = widthUpTo(record, 1200);
---
<figure class="spin-figure" style={paletteVars(record)}>
  <div
    class="stage"
    data-spin={JSON.stringify(spec)}
    data-spin-mode="manual"
    tabindex="0"
    role="img"
    aria-label={`${title}, a 360 degree view. Drag, or use the left and right arrow keys, to turn it.`}
    style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  >
    <img
      src={framePath(record, size, 0)}
      srcset={frameSrcSet(record, 0)}
      sizes="(max-width: 900px) 92vw, 46vw"
      alt={title}
      width={size}
      height={size}
      decoding="async"
      draggable="false"
    />
    {t.dragHint && <span class="hint" aria-hidden="true">{t.dragHint}</span>}
  </div>
  <!-- Runs as the page is parsed, before it first paints: if a tile on the
       previous page left a note for this spin, show the frame it had on screen
       and start from its angle, so the view transition lands on the same view
       of the pot. The key and shape match bindHandoff in src/scripts/spin.ts. -->
  <script is:inline define:vars={{ spinId: record.id }}>
    (() => {
      const stage = document.currentScript.previousElementSibling;
      try {
        const raw = sessionStorage.getItem('spin-handoff');
        if (!raw) return;
        sessionStorage.removeItem('spin-handoff');
        const note = JSON.parse(raw);
        if (note.id !== spinId || Date.now() - note.at > 10000) return;
        const img = stage.querySelector('img');
        if (note.src) {
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
          img.src = note.src;
        }
        stage.dataset.spinStart = String(note.rotation);
        if (note.spinning) stage.dataset.spinContinue = 'true';
      } catch (e) {
        /* no note, or storage unavailable: open at the front */
      }
    })();
  </script>

  <div class="controls">
    <button type="button" class="ctl" data-action="toggle-spin" aria-pressed="false">
      <span class="when-off">{t.turnButton}</span>
      <span class="when-on">{t.stopButton}</span>
    </button>
    <button type="button" class="ctl" data-action="tilt" aria-pressed="false" hidden>
      <span class="when-off">{t.tiltButton}</span>
      <span class="when-on">{t.tiltStop}</span>
    </button>
  </div>
</figure>

<style>
  .spin-figure { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--piece-linen, var(--paper-2));
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .stage:active { cursor: grabbing; }
  .stage img { width: 100%; height: 100%; object-fit: cover; }

  .hint {
    position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%);
    padding: 0.3rem 0.7rem; border-radius: var(--radius-sm);
    background: rgba(246, 246, 239, 0.82); color: var(--ink);
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    transition: opacity 0.25s ease;
  }
  .stage[data-spin-state="spinning"] .hint { opacity: 0; }

  .controls { margin-top: 0.9rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .ctl {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg-soft);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .ctl:hover { color: var(--ink); border-color: var(--ink); }
  .ctl[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .when-on { display: none; }
  [aria-pressed="true"] .when-on { display: inline; }
  [aria-pressed="true"] .when-off { display: none; }
</style>

<script>
  import { initSpins, getSpin } from '../scripts/spin';

  initSpins();

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  /** Degrees of turn per degree of tilt: a quarter tilt is a full turn. */
  const TILT_GAIN = 4;

  document.querySelectorAll<HTMLElement>('.spin-figure').forEach((figure) => {
    const stage = figure.querySelector<HTMLElement>('.stage');
    if (!stage) return;
    const spin = getSpin(stage);
    if (!spin) return;

    const toggle = figure.querySelector<HTMLButtonElement>('[data-action="toggle-spin"]');
    const tiltBtn = figure.querySelector<HTMLButtonElement>('[data-action="tilt"]');
    const pressed = (b: HTMLButtonElement | null, on: boolean) => b?.setAttribute('aria-pressed', String(on));

    // -- tilt ---------------------------------------------------------
    // The phone's side-to-side tilt turns the piece. iOS asks permission
    // the first time, which it only allows from a tap, hence the button.
    let tilting = false;
    let zero: number | null = null;
    let base = 0;
    let eased = 0;
    let heard = 0;

    const reading = (e: DeviceOrientationEvent) => {
      const angle = screen.orientation?.angle ?? 0;
      if (angle === 90) return e.beta;
      if (angle === 270 || angle === -90) return e.beta == null ? null : -e.beta;
      return e.gamma;
    };

    const onOrient = (e: DeviceOrientationEvent) => {
      const tilt = reading(e);
      if (tilt == null) return;
      heard++;
      if (zero === null) {
        zero = tilt;
        eased = 0;
      }
      // Eased toward the target so a shaky hand turns the piece smoothly.
      eased += ((tilt - zero) * TILT_GAIN - eased) * 0.2;
      spin.rotation = base + eased;
      spin.render();
    };

    const stopTilt = () => {
      if (!tilting) return;
      tilting = false;
      window.removeEventListener('deviceorientation', onOrient);
      pressed(tiltBtn, false);
    };

    const startTilt = async () => {
      const DOE = DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> };
      if (typeof DOE.requestPermission === 'function') {
        try {
          if ((await DOE.requestPermission()) !== 'granted') return;
        } catch {
          return;
        }
      }
      spin.stop();
      pressed(toggle, false);
      await spin.load();
      base = spin.rotation;
      zero = null;
      heard = 0;
      tilting = true;
      window.addEventListener('deviceorientation', onOrient);
      pressed(tiltBtn, true);
      // Some devices have the API but no sensor. Nothing arriving means no tilt.
      window.setTimeout(() => {
        if (tilting && heard === 0) {
          stopTilt();
          if (tiltBtn) tiltBtn.hidden = true;
        }
      }, 1200);
    };

    if (tiltBtn && 'DeviceOrientationEvent' in window && matchMedia('(pointer: coarse)').matches) {
      tiltBtn.hidden = false;
      tiltBtn.addEventListener('click', () => (tilting ? stopTilt() : startTilt()));
    }

    // -- turn it ------------------------------------------------------
    toggle?.addEventListener('click', () => {
      stopTilt();
      const on = toggle.getAttribute('aria-pressed') === 'true';
      if (on) spin.stop();
      else spin.load().then(() => spin.spinFreely());
      pressed(toggle, !on);
    });

    stage.addEventListener('pointerdown', () => {
      stopTilt();
      pressed(toggle, false);
    });

    // Arrived from a tile that was turning: keep it turning.
    if (stage.dataset.spinContinue === 'true' && !reduceMotion) {
      spin.load().then(() => spin.spinFreely());
      pressed(toggle, true);
    } else if (stage.dataset.spinStart) {
      spin.load().then(() => spin.render());
    }
  });
</script>
