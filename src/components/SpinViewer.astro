---
/**
 * The full-size turntable on a piece's own page.
 *
 * Drag to turn it, or let it turn itself. Where the rotation angles were
 * measured off the real shoot, playback maps through them so the piece turns
 * at a constant rate even though the photographed steps are uneven.
 *
 * Frames are real photographs, unevenly spaced, and the turn is a little
 * steppy because of it. That is the honest article.
 */
import type { SpinRecord } from '../lib/spins';
import { spinSpec, framePath, paletteVars } from '../lib/spins';

interface Props {
  record: SpinRecord;
  title: string;
}
const { record, title } = Astro.props;
const spec = spinSpec(record, 'd');
const size = record.sizes.d;

// Said plainly under the viewer. Two of the four pieces could not have their
// rotation measured, and the site does not pretend otherwise.
const provenance = record.anglesMeasured
  ? `${record.count} photographs · measured rotation`
  : `${record.count} photographs · even spacing assumed`;
---
<figure class="spin-figure" style={paletteVars(record)}>
  <div
    class="stage"
    data-spin={JSON.stringify(spec)}
    data-spin-mode="manual"
    data-ground="linen"
    tabindex="0"
    role="img"
    aria-label={`${title}, a 360 degree view. Drag, or use the left and right arrow keys, to turn it.`}
  >
    <img
      src={framePath(record, 'd', 0)}
      alt={title}
      width={size}
      height={size}
      decoding="async"
      draggable="false"
    />
    <span class="hint" aria-hidden="true">Drag to turn</span>
  </div>

  <div class="controls">
    <button type="button" class="ctl" data-action="toggle-spin" aria-pressed="false">
      <span class="when-off">Turn it</span>
      <span class="when-on">Stop</span>
    </button>

    {record.hasCutout ? (
      <div class="grounds" role="group" aria-label="Background">
        <button type="button" class="ctl" data-ground-btn="linen" aria-pressed="true">On linen</button>
        <button type="button" class="ctl" data-ground-btn="cutout" aria-pressed="false">Cut out</button>
      </div>
    ) : (
      /* This piece has no cutout and cannot have one until it is re-shot:
         the pale saucer sits in the same tonal range as the shadowed linen.
         Saying so beats an absent control the visitor cannot explain. */
      <p class="only-linen">Photographed on linen</p>
    )}
  </div>

  <figcaption>{provenance}</figcaption>
</figure>

<style>
  .spin-figure { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--piece-linen, var(--paper-2));
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .stage:active { cursor: grabbing; }
  .stage img { width: 100%; height: 100%; object-fit: cover; }
  /* With the background cut away the piece floats on the page's own ground. */
  .stage[data-ground="cutout"] { background: var(--paper); }
  .stage[data-ground="cutout"] img { object-fit: contain; }

  .hint {
    position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%);
    padding: 0.3rem 0.7rem; border-radius: var(--radius-sm);
    background: rgba(246, 244, 239, 0.82); color: var(--ink);
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    transition: opacity 0.25s ease;
  }
  .stage[data-spin-state="spinning"] .hint { opacity: 0; }

  .controls {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
    margin-top: 0.9rem;
  }
  .grounds { display: inline-flex; gap: 0.35rem; }
  .ctl {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg-soft);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .ctl:hover { color: var(--ink); border-color: var(--ink); }
  .ctl[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .when-on { display: none; }
  [aria-pressed="true"] .when-on { display: inline; }
  [aria-pressed="true"] .when-off { display: none; }

  .only-linen, figcaption {
    margin: 0;
    font-size: 0.75rem; letter-spacing: 0.08em;
    color: var(--fg-faint);
  }
  figcaption { margin-top: 0.75rem; }
</style>

<script>
  import { initSpins, getSpin } from '../scripts/spin';

  initSpins();

  document.querySelectorAll<HTMLElement>('.spin-figure').forEach((figure) => {
    const stage = figure.querySelector<HTMLElement>('.stage');
    if (!stage) return;
    const spin = getSpin(stage);
    if (!spin) return;

    const toggle = figure.querySelector<HTMLButtonElement>('[data-action="toggle-spin"]');
    toggle?.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-pressed') === 'true';
      if (on) spin.stop();
      else spin.load().then(() => spin.spinFreely());
      toggle.setAttribute('aria-pressed', String(!on));
    });

    // Dragging the piece by hand stops it turning itself; keep the button honest.
    stage.addEventListener('pointerdown', () => toggle?.setAttribute('aria-pressed', 'false'));

    figure.querySelectorAll<HTMLButtonElement>('[data-ground-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ground = btn.dataset.groundBtn!;
        figure.querySelectorAll<HTMLButtonElement>('[data-ground-btn]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b === btn))
        );
        stage.dataset.ground = ground;
        spin.setVariant(ground === 'cutout' ? 'c' : 'd');
      });
    });
  });
</script>
