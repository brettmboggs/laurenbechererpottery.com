---
interface Props { announcement?: string; logoImage?: string; siteTitle?: string }
const { announcement, logoImage, siteTitle = 'Lauren Becherer Pottery' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/portfolio/', label: 'Work' },
  { href: '/shop/', label: 'Shop' },
  { href: '/journal/', label: 'Journal' },
  { href: '/about/', label: 'About' },
  { href: '/client/', label: 'Commissions' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
{announcement && <div class="announce">{announcement}</div>}
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${siteTitle} — home`}>
      {logoImage ? (
        <img class="logo-img" src={logoImage} alt={siteTitle} />
      ) : (
        <span class="name">Lauren Becherer <span class="thin">Pottery</span></span>
      )}
    </a>
    <nav aria-label="Primary">
      <button class="menu-btn" aria-expanded="false" aria-controls="nav-list">Menu</button>
      <ul id="nav-list">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .announce {
    background: var(--paper-2);
    color: var(--fg-soft);
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.6rem var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 74px; position: relative; }
  .brand { display: inline-flex; align-items: center; }
  .logo-img { height: 40px; width: auto; max-width: 240px; object-fit: contain; }
  .name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .thin { font-style: italic; color: var(--fg-soft); }

  ul { list-style: none; display: flex; gap: clamp(1rem, 2.4vw, 2rem); margin: 0; padding: 0; }
  li a {
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-soft);
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  li a:hover { color: var(--ink); }
  li a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }

  .menu-btn {
    display: none;
    background: none; border: 1px solid var(--line-strong); border-radius: var(--radius);
    padding: 0.4rem 0.85rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-soft);
  }
  @media (max-width: 780px) {
    .menu-btn { display: inline-block; }
    .name { font-size: 1.1rem; }
    ul {
      display: none; position: absolute; left: calc(-1 * var(--gutter)); right: calc(-1 * var(--gutter));
      top: 100%; flex-direction: column; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--line);
      padding: 0.25rem var(--gutter) 1rem;
    }
    ul.open { display: flex; }
    li a { display: block; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
    li a[aria-current="page"] { border-bottom-color: var(--ink); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const list = document.getElementById('nav-list');
  btn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
