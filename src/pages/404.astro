---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const t = (await getEntry('notfound', 'notfound'))!.data;
---
<Base title={t.title} noindex>
  <section class="section">
    <div class="wrap" style="text-align:center; max-width: 620px;">
      {t.eyebrow && <p class="eyebrow">{t.eyebrow}</p>}
      <h1>{t.heading}</h1>
      {t.intro && <p class="lead" style="margin-inline:auto">{t.intro}</p>}
      <p><a class="btn" href="/">{t.homeButton}</a> <a class="btn ghost" href="/portfolio/">{t.workButton}</a></p>
    </div>
  </section>
</Base>
