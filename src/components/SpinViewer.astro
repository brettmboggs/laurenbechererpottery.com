---
/**
 * 360° photo turntable. Give it an ordered list of photos taken around a piece
 * (e.g. every 10–15°) and visitors can drag to spin it. Works with 8–72 frames.
 */
interface Props { frames: string[]; alt: string; height?: string }
const { frames, alt, height = '520px' } = Astro.props;
---
<div class="spin" data-frames={JSON.stringify(frames)} style={`--h:${height}`} tabindex="0" aria-label={`${alt} — drag or use arrow keys to rotate`} role="img">
  <img src={frames[0]} alt={alt} draggable="false" />
  <div class="spin-hint">↔ Drag to spin</div>
</div>

<style>
  .spin { position: relative; width: 100%; height: var(--h); border-radius: var(--radius); overflow: hidden; cursor: grab; user-select: none; touch-action: pan-y;
    background: radial-gradient(120% 100% at 50% 100%, var(--peach) 0%, var(--cream) 45%, var(--sand) 100%); outline-offset: 4px; }
  .spin:active { cursor: grabbing; }
  .spin img { width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .spin-hint { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); padding: 0.35rem 0.8rem; border-radius: 999px; background: rgba(255,247,238,.9); font-size: 0.8rem; font-weight: 700; color: var(--plum); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.spin').forEach((el) => {
    const frames: string[] = JSON.parse(el.dataset.frames || '[]');
    const img = el.querySelector('img')!;
    if (frames.length < 2) return;
    frames.forEach((src) => { const i = new Image(); i.src = src; });

    let index = 0;
    let dragging = false;
    let startX = 0;
    let startIndex = 0;
    const pxPerFrame = Math.max(6, Math.round(el.clientWidth / frames.length));
    const show = (i: number) => { index = ((i % frames.length) + frames.length) % frames.length; img.src = frames[index]; };

    el.addEventListener('pointerdown', (e) => { dragging = true; startX = e.clientX; startIndex = index; el.setPointerCapture(e.pointerId); });
    el.addEventListener('pointermove', (e) => { if (!dragging) return; show(startIndex + Math.round((e.clientX - startX) / pxPerFrame)); });
    const stop = () => { dragging = false; };
    el.addEventListener('pointerup', stop); el.addEventListener('pointercancel', stop); el.addEventListener('pointerleave', stop);
    el.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(index + 1); if (e.key === 'ArrowLeft') show(index - 1); });
  });
</script>
