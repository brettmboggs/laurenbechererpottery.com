---
// Studio admin (Sveltia CMS). Rendered by Astro so /admin/ works in dev and in production.
// Configuration lives in public/admin/config.yml.
//
// The sign-in screen is dressed to match the site. See src/styles/admin.css —
// it only applies while the flag below is set, so if a CMS upgrade moves the
// markup, the stock screen shows instead of a broken one.
import '../styles/admin.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Studio — Lauren Becherer Pottery</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="cms-config-url" type="application/yaml" href="/admin/config.yml" />
    <!-- Sveltia encodes every save with Uint8Array#toBase64, which Safari only
         gained in 18.2. On an older Mac every save failed with "toBase64 is not
         a function", so fill it in (and its fromBase64 pair) when missing. -->
    <script is:inline>
      (() => {
        const U8 = Uint8Array;
        if (!U8.prototype.toBase64) {
          Object.defineProperty(U8.prototype, 'toBase64', {
            configurable: true,
            writable: true,
            value(options = {}) {
              let binary = '';
              for (let i = 0; i < this.length; i += 0x8000) {
                binary += String.fromCharCode.apply(null, this.subarray(i, i + 0x8000));
              }
              let out = btoa(binary);
              if (options.alphabet === 'base64url') out = out.replace(/\+/g, '-').replace(/\//g, '_');
              if (options.omitPadding) out = out.replace(/=+$/, '');
              return out;
            },
          });
        }
        if (!U8.fromBase64) {
          Object.defineProperty(U8, 'fromBase64', {
            configurable: true,
            writable: true,
            value(string) {
              let s = String(string).replace(/\s+/g, '').replace(/-/g, '+').replace(/_/g, '/');
              while (s.length % 4) s += '=';
              const binary = atob(s);
              const bytes = new U8(binary.length);
              for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
              return bytes;
            },
          });
        }
      })();
    </script>
    <!-- Pinned on purpose. This is the only thing standing between Lauren and
         her own site, so it must not change under her because an upstream
         release shipped. Bump deliberately, then check /admin/ still loads. -->
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.210.3/dist/sveltia-cms.js"></script>
  </head>
  <body>
    <script is:inline>
      // Sveltia renders its own sign-in screen. Rather than fork the CMS, this
      // relabels that one heading and flags the page so the stylesheet can dress
      // it. Everything is guarded: if the heading is not the stock one, nothing
      // is touched, and the flag is cleared the moment the screen goes away.
      (() => {
        const LINES = [
          'wash the clay off first',
          'mind the wet pots',
          'the kiln is still warm',
          'no clay on the keyboard',
          'throw first, type later',
        ];
        const line = LINES[Math.floor(Math.random() * LINES.length)];
        const root = document.documentElement;

        const apply = () => {
          const heading = [...document.querySelectorAll('h1')].find(
            (h) => /^\s*sveltia cms\s*$/i.test(h.textContent || '') || h.dataset.studioBranded
          );

          if (!heading) {
            // Signed in, or the screen has not rendered yet. Either way, hands off.
            delete root.dataset.studioLogin;
            return;
          }

          root.dataset.studioLogin = '';
          if (heading.dataset.studioBranded) return;

          heading.textContent = "Lauren's Studio";
          heading.dataset.studioBranded = 'true';

          const sub = document.createElement('p');
          sub.className = 'studio-sub';
          sub.textContent = line;
          heading.after(sub);
        };

        apply();
        new MutationObserver(apply).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
