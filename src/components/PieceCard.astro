---
/**
 * One piece on the wall.
 *
 * Every tile is a photograph on its own linen ground — the same ground the
 * piece was shot on. That is deliberate: one piece cannot be cut out at all
 * and can only ever appear on its linen, so the wall is built to the rule
 * rather than to the exception. A future piece whose glaze will not separate
 * needs no special handling here.
 *
 * The tile ships exactly one frame. Everything else loads only if the visitor
 * shows intent — see src/scripts/spin.ts.
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import { transitionName } from '../lib/pieces';
import { getSpinRecord, spinSpec, framePath, frameSrcSet, widthUpTo, paletteVars } from '../lib/spins';

interface Props {
  piece: CollectionEntry<'pieces'>;
  showPrice?: boolean;
  /** Loading priority for the first row of the wall. */
  eager?: boolean;
  /** Shown in "Found a home": faded until hovered, with no price. */
  archived?: boolean;
}
const { piece, showPrice = false, eager = false, archived = false } = Astro.props;
const d = piece.data;
const href = `/portfolio/${piece.id}/`;
const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const spin = getSpinRecord(d.spin);
// A wall can have dozens of pieces turning, so its frames are capped well
// below what a single piece on its own page may load.
const spec = spin ? spinSpec(spin, 800) : null;
const still = spin ? framePath(spin, widthUpTo(spin, 800), 0) : d.cover || '';
const stillSrcSet = spin ? frameSrcSet(spin, 0) : undefined;
const size = spin ? widthUpTo(spin, 800) : 800;

// The line under the title. Nothing here is invented: a piece with no
// collection and no materials recorded simply shows nothing.
const meta = d.collection ?? d.materials ?? '';
const t = (await getEntry('piece', 'piece'))!.data;
const statusLabel: Record<string, string> = { sold: t.sold, reserved: t.reserved };
---
<a
  class:list={['tile', { archived }]}
  href={href}
  style={paletteVars(spin)}
  data-spin={spec ? JSON.stringify(spec) : undefined}
  data-spin-mode={spec ? 'hover' : undefined}
  aria-label={spec ? `${d.title} — hover or focus to turn the piece` : d.title}
>
  <div class="plate" style={`view-transition-name: ${transitionName(piece)}`}>
    {still ? (
      <img
        src={still}
        srcset={stillSrcSet}
        sizes="(max-width: 560px) 92vw, (max-width: 1000px) 45vw, 260px"
        alt={d.title}
        width={size}
        height={size}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        draggable="false"
      />
    ) : (
      <div class="plate-empty" aria-hidden="true"></div>
    )}
    {statusLabel[d.status] && <span class="badge">{statusLabel[d.status]}</span>}
    {spec && t.spinBadge && (
      <span class="turn" aria-hidden="true">
        <span class="turn-mark">{t.spinBadge}</span>
      </span>
    )}
  </div>
  <div class="body">
    <h3>{d.title}</h3>
    <p class="meta">
      <span>{meta}</span>
      {showPrice && d.price != null && <span class="price">{money(d.price)}</span>}
    </p>
  </div>
</a>

<style>
  .tile {
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .plate {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--piece-linen, var(--paper-2));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    /* The frames are square photographs of a piece on linen. Nothing is
       cropped: the plate is the photograph. */
    touch-action: pan-y;
  }
  .plate img { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .plate-empty { width: 100%; height: 100%; background: var(--paper-3); }

  .tile:hover .plate, .tile:focus-visible .plate { border-color: var(--line-strong); }

  .badge {
    position: absolute; top: 0.75rem; left: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-sm);
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.14em; text-transform: lowercase;
  }

  /* A quiet mark, so it is obvious which pieces turn. It fades out while the
     piece is actually turning — the motion says it better than the label. */
  .turn {
    position: absolute; right: 0.75rem; bottom: 0.75rem;
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em;
    color: var(--ink);
    background: rgba(246, 246, 239, 0.78);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: opacity 0.25s ease;
  }
  .tile[data-spin-state="spinning"] .turn,
  .tile[data-spin-state="loading"] .turn { opacity: 0; }

  /* A sold piece rests a little faded and warms back to its true colour when
     someone looks at it, so the archive reads as memory, not stock. */
  .archived .plate img {
    filter: saturate(0.55) brightness(1.04);
    opacity: 0.82;
    transition: filter 0.4s ease, opacity 0.4s ease;
  }
  .archived:hover .plate img,
  .archived:focus-visible .plate img,
  .archived[data-spin-state="spinning"] .plate img { filter: none; opacity: 1; }
  .archived .body h3 { font-size: 0.95rem; color: var(--fg-soft); }
  .archived .meta { font-size: 0.78rem; }

  .body { padding: 0.9rem 0.1rem 0; }
  .body h3 { margin: 0 0 0.15rem; font-size: 1.1rem; }
  .meta {
    margin: 0;
    display: flex; justify-content: space-between; gap: 0.75rem;
    font-size: 0.85rem; color: var(--fg-faint);
  }
  .price { color: var(--fg-soft); }

  /* While a set is arriving, a hairline under the plate says so without a
     spinner covering the piece. */
  .tile[data-spin-state="loading"] .plate::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--piece-accent, var(--accent));
    opacity: 0.55;
    animation: sweep 1s ease-in-out infinite;
  }
  @keyframes sweep { 0% { transform: scaleX(0); transform-origin: left; } 50% { transform: scaleX(1); transform-origin: left; } 51% { transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }
</style>

<script>
  import { initSpins } from '../scripts/spin';
  initSpins();
</script>
