---
/**
 * About.
 *
 * The photograph leads the page as a hero: wider than the writing, full bleed
 * on a phone, and dissolving into the paper on every edge rather than stopping
 * at one. It used to hang in a gold frame, which put a second, louder object on
 * a page that only wants the one.
 */
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import EditLink from '../components/EditLink.astro';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
---
<Base title={about.data.title} description={about.data.subtitle}>
  <section class="section">
    {about.data.portrait && (
      <figure class="hero">
        <img
          src={about.data.portrait}
          alt={`Portrait of ${about.data.title.replace('About ', '')}`}
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="wrap about">
      <div class="body">
        <p class="eyebrow">About</p>
        <h1>{about.data.title}</h1>
        {about.data.subtitle && <p class="lead">{about.data.subtitle}</p>}
        <div class="prose"><Content /></div>
      </div>
    </div>

    {about.data.studioImages.length > 0 && (
      <div class="wrap studio grid cols-3">
        {about.data.studioImages.map((s) => <img src={s.image} alt={s.alt ?? 'In the studio'} loading="lazy" />)}
      </div>
    )}
  </section>

  <EditLink collection="pages" entry="about" label="edit this page" />
</Base>

<style>
  /* The hero runs wider than the reading column and ignores the page gutter, so
     the photograph is the first thing the page does rather than an illustration
     beside the writing. */
  .hero {
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
    width: min(100%, 1500px);
  }

  /* Every edge dissolves into the paper instead of ending on a line. Two
     gradients, one per axis, intersected: a single gradient would only soften
     one pair of sides. The stops are asymmetric on purpose - the top holds
     longer because that is where the room and her face are, and the bottom
     lets the table of pots fade out. */
  .hero img {
    width: 100%;
    height: auto;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 19%, #000 81%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 13%, #000 74%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0, #000 19%, #000 81%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 13%, #000 74%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* A browser without mask-composite would apply only the last gradient and
     leave the left and right edges hard. Fall back to no fade at all rather
     than a fade on one axis, which reads as a mistake. */
  @supports not ((mask-composite: intersect) or (-webkit-mask-composite: source-in)) {
    .hero img { -webkit-mask-image: none; mask-image: none; }
  }

  .about { display: grid; justify-items: center; }
  .body { width: 100%; max-width: 68ch; }
  .body .prose { max-width: none; }

  .studio { margin-top: clamp(3rem, 7vw, 5rem); }
  .studio img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; }
</style>
