---
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import EditLink from '../components/EditLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { getSpinRecord, spinSpec, framePath, frameSrcSet, widthUpTo, paletteVars } from '../lib/spins';
import { listablePieces, spreadByHue } from '../lib/pieces';

const settings = (await getEntry('settings', 'site'))!.data;
const pieces = listablePieces(await getCollection('pieces'));

// The hero is a real piece, turning, at full resolution — it is the largest
// thing on the site and the first work anyone sees, so it gets the native
// frames rather than the small wall set.
const heroPiece = pieces.find((p) => getSpinRecord(p.data.spin));
const heroSpin = getSpinRecord(heroPiece?.data.spin);
const heroSpec = heroSpin ? spinSpec(heroSpin, 1200) : null;
const heroWidth = heroSpin ? widthUpTo(heroSpin, 1200) : 0;

// Everything else, in full. The home page is the gallery: every piece that is
// still available belongs here, and a sold one drops off the site entirely.
const latest = spreadByHue(pieces.filter((p) => p.id !== heroPiece?.id));

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="eyebrow">Handmade ceramics</p>
        <h1>{settings.heroHeading}</h1>
        <p class="lead">{settings.heroSubheading}</p>
        <div class="cta">
          <a class="btn" href="/portfolio/">See the work</a>
          <a class="btn ghost" href="/client/">Commission a piece</a>
        </div>
      </div>

      {heroSpec && heroSpin && heroPiece ? (
        <a
          class="hero-piece"
          href={`/portfolio/${heroPiece.id}/`}
          style={paletteVars(heroSpin)}
          data-spin={JSON.stringify(heroSpec)}
          data-spin-mode="hover"
          aria-label={`${heroPiece.data.title} — hover to turn the piece`}
        >
          <img
            src={framePath(heroSpin, heroWidth, 0)}
            srcset={frameSrcSet(heroSpin, 0)}
            sizes="(max-width: 880px) 92vw, 46vw"
            alt={heroPiece.data.title}
            width={heroWidth}
            height={heroWidth}
            decoding="async"
            fetchpriority="high"
            draggable="false"
          />
          <span class="hero-mark">Turn it</span>
        </a>
      ) : settings.heroImage ? (
        <div class="hero-piece static"><img src={settings.heroImage} alt="" /></div>
      ) : null}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Work</h2>
        <a class="btn quiet small" href="/portfolio/">All work →</a>
      </div>
      <div class="grid cols-3">
        {latest.map((p) => <PieceCard piece={p} showPrice={p.data.forSale} />)}
      </div>
    </div>
  </section>
  <section class="section band">
    <div class="wrap band-grid">
      <div>
        <p class="eyebrow">Made to order</p>
        <h2>Commission a piece</h2>
        <p class="lead">
          Dinnerware for your table, a vase for the mantel, mugs for the whole family. Tell me what
          you have in mind and follow it along on your own project page.
        </p>
        <a class="btn" href="/client/">{settings.commissionsOpen ? 'Start a commission' : 'Join the waitlist'}</a>
      </div>
      <ol class="steps">
        <li><span>01</span> Tell me your idea</li>
        <li><span>02</span> Deposit and sketch approval</li>
        <li><span>03</span> Watch it take shape</li>
        <li><span>04</span> Delivered to your door</li>
      </ol>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>From the journal</h2>
          <a class="btn quiet small" href="/journal/">All posts →</a>
        </div>
        <div class="grid cols-2">
          {posts.map((post) => (
            <a class="post" href={`/journal/${post.id}/`}>
              {post.data.cover && <div class="post-media"><img src={post.data.cover} alt="" loading="lazy" /></div>}
              <p class="eyebrow">
                {post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' })}
              </p>
              <h3>{post.data.title}</h3>
              {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <EditLink collection="settings" entry="site" label="edit site settings" />
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 8vw, 6rem); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .hero h1 { margin-bottom: 0.4em; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem; }

  .hero-piece {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--piece-linen, var(--paper-2));
    touch-action: pan-y;
  }
  .hero-piece img { width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .hero-mark {
    position: absolute; right: 1rem; bottom: 1rem;
    padding: 0.3rem 0.7rem; border-radius: var(--radius-sm);
    background: rgba(246, 244, 239, 0.82); color: var(--ink);
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    transition: opacity 0.25s ease;
  }
  .hero-piece[data-spin-state="spinning"] .hero-mark,
  .hero-piece[data-spin-state="loading"] .hero-mark { opacity: 0; }

  .band { background: var(--bg-soft); border-block: 1px solid var(--line); }
  .band-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li {
    display: flex; align-items: baseline; gap: 1rem;
    padding: 1rem 0; border-bottom: 1px solid var(--line);
    color: var(--fg-soft); font-size: 0.95rem;
  }
  .steps li:first-child { border-top: 1px solid var(--line); }
  .steps span {
    font-family: var(--font-display); font-size: 0.8rem; color: var(--fg-faint);
    letter-spacing: 0.06em;
  }

  .post { display: block; }
  .post-media { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); margin-bottom: 1rem; }
  .post-media img { width: 100%; height: 100%; object-fit: cover; }
  .post h3 { margin: 0 0 0.3rem; }
  .post:hover h3 { color: var(--accent); }
  .post-excerpt { margin: 0; color: var(--fg-faint); font-size: 0.9rem; }

  @media (max-width: 880px) {
    .hero-grid, .band-grid { grid-template-columns: 1fr; }
    .hero-piece { max-width: 440px; }
  }
</style>

<script>
  import { initSpins } from '../scripts/spin';
  initSpins();
</script>
