---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const clients = await getCollection('clients', ({ data }) => data.active);
  return clients.map((c) => ({ params: { code: c.data.code.toLowerCase() }, props: { client: c } }));
}
const { client } = Astro.props;
const d = client.data;
const { Content } = await render(client);
const settings = (await getEntry('settings', 'site'))!.data;

const stages = ['inquiry', 'deposit', 'in-progress', 'drying', 'firing', 'glazing', 'ready', 'shipped', 'complete'];
const labels: Record<string, string> = { inquiry: 'Inquiry', deposit: 'Deposit', 'in-progress': 'Making', drying: 'Drying', firing: 'Bisque fire', glazing: 'Glazing', ready: 'Ready', shipped: 'Shipped', complete: 'Complete' };
const stageIndex = stages.indexOf(d.status);
const updates = [...d.updates].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const fmt = (x: Date) => x.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
---
<Base title={`${d.name} — project`} noindex>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Private project page</p>
      <h1>Hi {d.name.split(' ')[0]}, here's your <span class="italic">{d.project}</span>.</h1>
      <p class="lead">Current stage: <strong>{labels[d.status]}</strong>{d.estimatedCompletion && <> · estimated completion <strong>{d.estimatedCompletion}</strong></>}</p>

      <ol class="progress" aria-label="Project progress">
        {stages.map((s, i) => <li class:list={{ done: i < stageIndex, now: i === stageIndex }}><span></span>{labels[s]}</li>)}
      </ol>

      {(d.depositLink || d.balanceLink) && (
        <div class="pay">
          {d.depositLink && <a class="btn" href={d.depositLink} target="_blank" rel="noopener">Pay deposit</a>}
          {d.balanceLink && <a class="btn" href={d.balanceLink} target="_blank" rel="noopener">Pay remaining balance</a>}
        </div>
      )}

      <div class="prose"><Content /></div>

      <h2>Updates</h2>
      <div class="timeline">
        {updates.map((u) => (
          <article class="update">
            <p class="eyebrow">{fmt(u.date)}</p>
            <p>{u.note}</p>
            {u.image && <img src={u.image} alt="" loading="lazy" />}
          </article>
        ))}
        {updates.length === 0 && <p class="notice">No updates yet — check back soon.</p>}
      </div>

      <p class="tiny">Questions? {settings.email && <a href={`mailto:${settings.email}?subject=${encodeURIComponent('Re: ' + d.project)}`}>Email me</a>}. This page is private to you — please don't share the link.</p>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 820px; }
  .progress { list-style: none; margin: 2rem 0; padding: 0; display: grid; grid-template-columns: repeat(9, 1fr); gap: 0.25rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg-soft); text-align: center; }
  .progress li { display: grid; gap: 0.4rem; justify-items: center; }
  .progress span { display: block; width: 100%; height: 8px; border-radius: 999px; background: var(--line); }
  .progress .done span { background: var(--line-strong); }
  .progress .now span { background: var(--ink); }
  .progress .now { color: var(--ink); }
  .pay { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0 2.5rem; }
  .timeline { display: grid; gap: 1.25rem; }
  .update { padding: 1.25rem 1.5rem; border-left: 1px solid var(--line-strong); background: var(--card); border-radius: 0 var(--radius) var(--radius) 0; }
  .update p:last-of-type { margin-bottom: 0; }
  .update img { margin-top: 1rem; border-radius: var(--radius-sm); max-height: 420px; object-fit: cover; }
  .tiny { font-size: 0.85rem; color: var(--fg-soft); margin-top: 3rem; }
  @media (max-width: 700px) { .progress { grid-template-columns: repeat(3, 1fr); gap: 0.75rem 0.5rem; } }
</style>
