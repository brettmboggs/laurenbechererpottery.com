---
/**
 * The wall. Everything Lauren has made, laid out flat.
 *
 * Hovering a piece turns it. Nothing but the first frame of each piece is
 * fetched until someone shows intent — the loading strategy lives in
 * src/scripts/spin.ts, not here, so this page stays a layout.
 */
import Base from '../../layouts/Base.astro';
import PieceCard from '../../components/PieceCard.astro';
import EditLink from '../../components/EditLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { listablePieces, spreadByHue } from '../../lib/pieces';

const pieces = spreadByHue(listablePieces(await getCollection('pieces')));

const collections = [...new Set(pieces.map((p) => p.data.collection).filter(Boolean))] as string[];
const t = (await getEntry('work', 'work'))!.data;
const nav = (await getEntry('layout', 'layout'))!.data;
---
<Base title={nav.navWork} description={t.description || undefined}>
  <section class="section wall-section">
    <div class="wrap">
      <header class="wall-head">
        {t.eyebrow && <p class="eyebrow">{t.eyebrow}</p>}
        <h1>{t.heading}</h1>
        {t.intro && <p class="lead">{t.intro}</p>}
      </header>

      {collections.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by collection">
          <button class="chip" data-filter="all" aria-pressed="true">{t.allFilter}</button>
          {collections.map((c) => <button class="chip" data-filter={c} aria-pressed="false">{c}</button>)}
        </div>
      )}

      <div class="wall" id="pieces">
        {pieces.map((p, i) => (
          <div data-collection={p.data.collection ?? ''}>
            <PieceCard piece={p} showPrice={p.data.forSale} eager={i < 3} />
          </div>
        ))}
      </div>

      {pieces.length === 0 && t.empty && <p class="notice">{t.empty}</p>}
    </div>
  </section>

  <EditLink collection="pieces" label="add or edit pieces" />
</Base>

<style>
  .wall-head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .wall-head h1 { margin-bottom: 0.6rem; }

  .filters { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .chip {
    border: 1px solid var(--line-strong); background: transparent; border-radius: var(--radius);
    padding: 0.4rem 0.95rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    color: var(--fg-soft);
  }
  .chip:hover { color: var(--ink); border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* Square plates on a loose grid. Tiles never crop a piece: the frame is the
     photograph, linen and all. */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2.25rem);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('#pieces > [data-collection]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    const f = chip.dataset.filter;
    items.forEach((el) => { el.hidden = f !== 'all' && el.dataset.collection !== f; });
  }));
</script>
