---
import Base from '../../layouts/Base.astro';
import PieceViewer from '../../components/PieceViewer.astro';
import PieceCard from '../../components/PieceCard.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const pieces = await getCollection('pieces');
  return pieces.map((p) => ({ params: { slug: p.id }, props: { piece: p } }));
}

const { piece } = Astro.props;
const d = piece.data;
const { Content } = await render(piece);
const settings = (await getEntry('settings', 'site'))!.data;
const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

const more = (await getCollection('pieces', (p) => p.id !== piece.id && p.data.showInPortfolio))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const canBuy = d.forSale && d.status === 'available';
const inquire = `mailto:${settings.email ?? ''}?subject=${encodeURIComponent(`Inquiry: ${d.title}`)}`;
const statusLabel: Record<string, string> = { available: 'Available', sold: 'Sold', reserved: 'Reserved', commission: 'Commission piece' };

// Structured data so Google can show price/availability in search results.
const availability: Record<string, string> = { available: 'InStock', reserved: 'PreOrder', sold: 'SoldOut', commission: 'PreOrder' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  description: d.materials ? `${d.title}. ${d.materials}.` : d.title,
  image: [d.cover, ...d.gallery.map((g) => g.image)].map((p) => new URL(p, Astro.site).href),
  brand: { '@type': 'Brand', name: settings.title },
  material: d.materials,
  ...(d.forSale && d.price != null
    ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: 'USD', availability: `https://schema.org/${availability[d.status]}`, url: new URL(Astro.url.pathname, Astro.site).href } }
    : {}),
};
---
<Base title={d.title} description={`${d.title} — ${d.materials ?? 'handmade ceramics'} by Lauren Becherer.`} image={d.cover}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="section">
    <div class="wrap piece">
      <div class="viewer-col">
        <PieceViewer title={d.title} cover={d.cover} gallery={d.gallery} model={d.model || undefined} modelAutoRotate={d.modelAutoRotate} spinFrames={d.spinFrames} />
      </div>
      <div class="info">
        <p class="eyebrow">{d.collection ?? 'Portfolio'}</p>
        <h1>{d.title}</h1>
        <p class="status" data-status={d.status}>{statusLabel[d.status]}{d.forSale && d.price != null ? ` · ${money(d.price)}` : ''}</p>

        <div class="buy">
          {canBuy && d.stripeLink && <a class="btn sunset" href={d.stripeLink} target="_blank" rel="noopener">Buy now — {money(d.price ?? 0)}</a>}
          {canBuy && !d.stripeLink && <a class="btn sunset" href={inquire}>Inquire to purchase</a>}
          {!canBuy && d.status !== 'sold' && <a class="btn ghost" href={inquire}>Ask about this piece</a>}
          {d.status === 'sold' && <a class="btn ghost" href="/client/">Commission something similar</a>}
        </div>

        <dl class="specs">
          {d.dimensions && <><dt>Dimensions</dt><dd>{d.dimensions}</dd></>}
          {d.materials && <><dt>Materials</dt><dd>{d.materials}</dd></>}
          {d.firing && <><dt>Firing</dt><dd>{d.firing}</dd></>}
          <dt>Made</dt><dd>{d.date.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' })}</dd>
        </dl>

        <div class="prose"><Content /></div>
        <p class="care">Food-safe glazes unless noted. Hand wash recommended. Ships carefully packed within the US; local pickup available.</p>
      </div>
    </div>

    {more.length > 0 && (
      <div class="wrap more">
        <div class="section-head"><h2>More work</h2><a class="btn ghost small" href="/portfolio/">Full portfolio →</a></div>
        <div class="grid cols-3">{more.map((p) => <PieceCard piece={p} showPrice={p.data.forSale} />)}</div>
      </div>
    )}
  </article>
</Base>

<style>
  .piece { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .viewer-col { position: sticky; top: 96px; }
  .status { font-weight: 700; color: var(--fg-soft); margin-top: -0.5rem; }
  .status[data-status="available"] { color: #1f7a4d; }
  .status[data-status="sold"] { color: var(--rose); }
  .buy { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.25rem 0 2rem; }
  .specs { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.5rem; margin: 0 0 2rem; padding: 1.25rem; background: var(--bg-soft); border-radius: var(--radius-sm); }
  .specs dt { font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-soft); }
  .specs dd { margin: 0; }
  .care { font-size: 0.9rem; color: var(--fg-soft); margin-top: 2rem; }
  .more { margin-top: 5rem; }
  @media (max-width: 900px) { .piece { grid-template-columns: 1fr; } .viewer-col { position: static; } }
</style>
