---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
---
<Base title={about.data.title} description={about.data.subtitle}>
  <section class="section">
    <div class="wrap about">
      {about.data.portrait && (
        /* No frame, no mat, no rule. The photograph meets the page directly —
           anything drawn around it read as an object sitting on top of the
           page rather than part of it. */
        <div class="portrait">
          <img src={about.data.portrait} alt={`Portrait of ${about.data.title.replace('About ', '')}`} />
        </div>
      )}
      <div>
        <p class="eyebrow">About</p>
        <h1>{about.data.title}</h1>
        {about.data.subtitle && <p class="lead">{about.data.subtitle}</p>}
        <div class="prose"><Content /></div>
      </div>
    </div>
    {about.data.studioImages.length > 0 && (
      <div class="wrap studio grid cols-3">
        {about.data.studioImages.map((s) => <img src={s.image} alt={s.alt ?? 'In the studio'} loading="lazy" />)}
      </div>
    )}
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }

  .portrait { position: sticky; top: 100px; }
  .portrait img { width: 100%; height: auto; display: block; }
  .studio { margin-top: 4rem; }
  .studio img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; }
  @media (max-width: 800px) {
    .about { grid-template-columns: 1fr; }
    .portrait { position: static; }
  }
</style>
