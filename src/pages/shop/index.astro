---
import Base from '../../layouts/Base.astro';
import PieceCard from '../../components/PieceCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { sortPieces } from '../../lib/pieces';
import EditLink from '../../components/EditLink.astro';

const settings = (await getEntry('settings', 'site'))!.data;
const t = (await getEntry('shop', 'shop'))!.data;
const nav = (await getEntry('layout', 'layout'))!.data;
const forSale = sortPieces(await getCollection('pieces', ({ data }) => data.forSale)).sort((a, b) => {
  // Available work first; within a status, the site's shared order applies.
  const rank = (s: string) => (s === 'available' ? 0 : s === 'reserved' ? 1 : 2);
  return rank(a.data.status) - rank(b.data.status);
});
const available = forSale.filter((p) => p.data.status === 'available');
---
<Base title={nav.navShop} description={t.description || undefined}>
  <section class="section">
    <div class="wrap">
      {t.eyebrow && <p class="eyebrow">{t.eyebrow}</p>}
      <h1>{t.heading}</h1>
      {t.intro && <p class="lead">{t.intro}</p>}

      {available.length === 0 && (
        <div class="notice">
          {t.emptyText}{t.emptyLink && <>{' '}<a href="/portfolio/">{t.emptyLink}</a></>}
        </div>
      )}

      <div class="grid cols-3">
        {forSale.map((p) => <PieceCard piece={p} showPrice />)}
      </div>

      {t.faq.length > 0 && (
        <>
          <div class="divider"></div>
          <div class="faq grid cols-3">
            {t.faq.map((f) => (
              <div>
                {f.heading && <h3>{f.heading}</h3>}
                <p>
                  {f.text}
                  {f.emailLink && settings.email && <>{' '}<a href={`mailto:${settings.email}`}>{f.emailLink}</a></>}
                </p>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <EditLink collection="text" entry="shop" label="edit this page" />
</Base>

<style>
  .notice { margin-bottom: 2rem; }
  .faq h3 { font-size: 1.15rem; }
  .faq p { color: var(--fg-soft); }
</style>
