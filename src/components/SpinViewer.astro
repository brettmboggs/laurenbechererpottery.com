---
/**
 * The full-size turntable on a piece's own page.
 *
 * One thing, one control. Drag it to turn it, or press the button and let it
 * turn itself. There is no background switch and no treatment picker: the
 * piece is shown the way it was photographed.
 *
 * Where the rotation angles were measured off the real shoot, playback maps
 * through them so the piece turns at a constant rate even though the
 * photographed steps are uneven. The turn is a little steppy because every
 * frame is a real photograph and nothing between them is invented.
 */
import type { SpinRecord } from '../lib/spins';
import { spinSpec, framePath, frameSrcSet, widthUpTo, paletteVars } from '../lib/spins';

interface Props {
  record: SpinRecord;
  title: string;
}
const { record, title } = Astro.props;
// One piece, one viewer: it can afford the largest size the screen justifies.
const spec = spinSpec(record, 1200);
const size = widthUpTo(record, 1200);
---
<figure class="spin-figure" style={paletteVars(record)}>
  <div
    class="stage"
    data-spin={JSON.stringify(spec)}
    data-spin-mode="manual"
    tabindex="0"
    role="img"
    aria-label={`${title}, a 360 degree view. Drag, or use the left and right arrow keys, to turn it.`}
  >
    <img
      src={framePath(record, size, 0)}
      srcset={frameSrcSet(record, 0)}
      sizes="(max-width: 900px) 92vw, 46vw"
      alt={title}
      width={size}
      height={size}
      decoding="async"
      draggable="false"
    />
    <span class="hint" aria-hidden="true">Drag to turn</span>
  </div>

  <div class="controls">
    <button type="button" class="ctl" data-action="toggle-spin" aria-pressed="false">
      <span class="when-off">Turn it</span>
      <span class="when-on">Stop</span>
    </button>
  </div>
</figure>

<style>
  .spin-figure { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--piece-linen, var(--paper-2));
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .stage:active { cursor: grabbing; }
  .stage img { width: 100%; height: 100%; object-fit: cover; }

  .hint {
    position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%);
    padding: 0.3rem 0.7rem; border-radius: var(--radius-sm);
    background: rgba(246, 244, 239, 0.82); color: var(--ink);
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    transition: opacity 0.25s ease;
  }
  .stage[data-spin-state="spinning"] .hint { opacity: 0; }

  .controls { margin-top: 0.9rem; }
  .ctl {
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg-soft);
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .ctl:hover { color: var(--ink); border-color: var(--ink); }
  .ctl[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .when-on { display: none; }
  [aria-pressed="true"] .when-on { display: inline; }
  [aria-pressed="true"] .when-off { display: none; }
</style>

<script>
  import { initSpins, getSpin } from '../scripts/spin';

  initSpins();

  document.querySelectorAll<HTMLElement>('.spin-figure').forEach((figure) => {
    const stage = figure.querySelector<HTMLElement>('.stage');
    if (!stage) return;
    const spin = getSpin(stage);
    if (!spin) return;

    const toggle = figure.querySelector<HTMLButtonElement>('[data-action="toggle-spin"]');
    toggle?.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-pressed') === 'true';
      if (on) spin.stop();
      else spin.load().then(() => spin.spinFreely());
      toggle.setAttribute('aria-pressed', String(!on));
    });

    // Taking hold of the piece stops it turning itself; keep the button honest.
    stage.addEventListener('pointerdown', () => toggle?.setAttribute('aria-pressed', 'false'));
  });
</script>
