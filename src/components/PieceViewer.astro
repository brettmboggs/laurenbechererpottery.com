---
/**
 * The viewer on a piece's page. Shows the richest thing the piece has:
 * a 360° turntable, a 3D model, or plain photographs — and lets the visitor
 * switch when there is more than one.
 *
 * A piece with nothing but a spin folder works. A piece with nothing but a
 * cover photo works. Neither case needs a change here.
 */
import ModelViewer from './ModelViewer.astro';
import SpinViewer from './SpinViewer.astro';
import type { SpinRecord } from '../lib/spins';
import { framePath, widthUpTo } from '../lib/spins';

interface Props {
  title: string;
  cover?: string;
  gallery: { image: string; alt?: string }[];
  spin?: SpinRecord;
  model?: string;
  modelAutoRotate?: boolean;
}
const { title, cover, gallery, spin, model, modelAutoRotate = true } = Astro.props;

// Photographs: the cover first, then the gallery, with duplicates dropped.
// A piece with only a spin gets no Photos tab. Offering one that shows the
// first frame of the turntable is a control that does nothing.
const fallback = spin ? framePath(spin, widthUpTo(spin, 1200), 0) : undefined;
const photos = [
  ...(cover ? [{ image: cover, alt: title }] : []),
  ...gallery.filter((g) => g.image !== cover),
];

const has3d = !!model;
const hasSpin = !!spin;
const hasPhotos = photos.length > 0;
const tabs = [hasSpin && 'spin', has3d && '3d', hasPhotos && 'photos'].filter(Boolean) as string[];
const first = tabs[0];
---
<div class="viewer" data-viewer>
  {tabs.length > 1 && (
    <div class="tabs" role="tablist" aria-label="How to view this piece">
      {hasSpin && <button role="tab" data-tab="spin" aria-selected={first === 'spin' ? 'true' : 'false'}>360°</button>}
      {has3d && <button role="tab" data-tab="3d" aria-selected={first === '3d' ? 'true' : 'false'}>3D</button>}
      {hasPhotos && <button role="tab" data-tab="photos" aria-selected={first === 'photos' ? 'true' : 'false'}>Photos</button>}
    </div>
  )}

  {hasSpin && (
    <div class="pane" data-pane="spin" hidden={first !== 'spin'}>
      <SpinViewer record={spin!} title={title} />
    </div>
  )}

  {has3d && (
    <div class="pane" data-pane="3d" hidden={first !== '3d'}>
      <ModelViewer src={model!} poster={cover ?? fallback ?? ''} alt={`${title}, 3D model`} autoRotate={modelAutoRotate} />
    </div>
  )}

  {hasPhotos && (
    <div class="pane" data-pane="photos" hidden={first !== 'photos'}>
      <figure class="main">
        <img src={photos[0].image} alt={photos[0].alt ?? title} data-main-photo />
      </figure>
      {photos.length > 1 && (
        <div class="thumbs">
          {photos.map((p, i) => (
            <button class="thumb" data-src={p.image} data-alt={p.alt ?? title} aria-pressed={i === 0 ? 'true' : 'false'}>
              <img src={p.image} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
  )}
</div>

<style>
  .tabs { display: inline-flex; gap: 0.35rem; margin-bottom: 1rem; }
  .tabs button {
    border: 1px solid var(--line-strong); background: transparent; color: var(--fg-soft);
    border-radius: var(--radius); padding: 0.45rem 0.95rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: lowercase;
  }
  .tabs button:hover { color: var(--ink); border-color: var(--ink); }
  .tabs button[aria-selected="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .main {
    margin: 0; border-radius: var(--radius); overflow: hidden;
    background: var(--bg-soft); border: 1px solid var(--line);
    aspect-ratio: 1;
  }
  .main img { width: 100%; height: 100%; object-fit: cover; }
  .thumbs { display: flex; gap: 0.5rem; margin-top: 0.6rem; overflow-x: auto; padding-bottom: 0.25rem; }
  .thumb {
    flex: 0 0 64px; width: 64px; height: 64px; padding: 0;
    border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--line); background: var(--bg-soft);
  }
  .thumb[aria-pressed="true"] { border-color: var(--ink); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((t) =>
          t.setAttribute('aria-selected', String(t === tab))
        );
        root.querySelectorAll<HTMLElement>('.pane').forEach((p) => {
          p.hidden = p.dataset.pane !== tab.dataset.tab;
        });
      });
    });

    const main = root.querySelector<HTMLImageElement>('[data-main-photo]');
    root.querySelectorAll<HTMLButtonElement>('.thumb').forEach((b) => {
      b.addEventListener('click', () => {
        if (!main) return;
        main.src = b.dataset.src!;
        main.alt = b.dataset.alt || '';
        root.querySelectorAll('.thumb').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
      });
    });
  });
</script>
