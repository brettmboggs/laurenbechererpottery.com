---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="section">
    <div class="wrap" style="text-align:center; max-width: 620px;">
      <p class="eyebrow">404</p>
      <h1>That one didn't survive the kiln.</h1>
      <p class="lead" style="margin-inline:auto">The page you're looking for isn't here. If you typed a project code, double-check it — codes are case-insensitive but every character counts.</p>
      <p><a class="btn" href="/">Back home</a> <a class="btn ghost" href="/client/">Client portal</a></p>
    </div>
  </section>
</Base>
